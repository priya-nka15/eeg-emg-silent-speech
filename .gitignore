# ============================================================
# URF-ASSR project .gitignore
# ============================================================

# ---- Python: bytecode & caches ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ---- Packaging / build ----
build/
dist/
*.egg
*.egg-info/
.eggs/
wheels/
develop-eggs.py
sdist/
.installed.cfg
MANIFEST

# ---- Test / coverage / linter caches ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.mypy_cache/
.ruff_cache/
.pytype/
.dmypy.json

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
env.bak/
pythonenv*

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---- IDE / editors ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
*.sublime-project
*.sublime-workspace

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ---- Logs & runtime ----
*.log
logs/
*.out

# ---- Secrets / local config ----
.env
.env.*
!.env.example
secrets.json
*.secret

# ============================================================
# PROJECT-SPECIFIC: keep large/generated artifacts OUT of git
# ============================================================

# ---- Datasets (raw + processed EEG/EMG recordings, ~8 GB) ----
# Do NOT commit data/. Source code that *reads* data stays tracked.
data/

# ---- Trained model weights (binaries; keep configs/label maps tracked) ----
*.pt
*.pth
*.pkl
*.pickle
*.joblib
*.bin
*.h5
*.hdf5
*.onnx
*.safetensors
*.ckpt

# ---- Experiment outputs (regenerated by scripts/run_experiments.py) ----
# Uncomment the next line if you don't want to track experiment results:
# experiments/results.json
